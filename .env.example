# Random secret used to sign session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection string, provisioned automatically by the Neon
# integration on Vercel (Storage tab). Not needed for local dev unless you
# want persistence — the app falls back to the static seed gallery without it.
DATABASE_URL=

# Provisioned automatically by Vercel Blob (Storage tab).
BLOB_READ_WRITE_TOKEN=
