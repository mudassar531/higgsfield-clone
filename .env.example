# Random secret used to sign session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Private Postgres database (Neon on the Vercel Marketplace).
# Run npm run db:migrate after connecting it.
DATABASE_URL=

# Public generated image files only. Accounts and credits live in Postgres.
BLOB_READ_WRITE_TOKEN=

# Optional: use the authenticated Pollinations API instead of its shared free endpoint.
# Create a server key at https://enter.pollinations.ai/keys. Never expose it to the browser.
POLLINATIONS_API_KEY=
